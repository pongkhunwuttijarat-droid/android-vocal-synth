<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- InternalsVisibleTo("OpenUtau.Test") trick: OpenUtau.Core exposes
         RenderEngine, RenderPhrase etc. only to OpenUtau.Test.
         Naming THIS assembly "OpenUtau.Test" grants us those internals
         without touching ref/ (which is read-only). -->
    <AssemblyName>OpenUtau.Test</AssemblyName>
    <RootNamespace>GoldenRenderer</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(OPENUTAU_REF)/core/OpenUtau.Core/OpenUtau.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

</Project>
