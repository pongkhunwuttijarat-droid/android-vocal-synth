    vibrato: {length: 0, period: 175, depth: 25, in: 10, out: 10, shift: 0, drift: 0}
  - position: 1440
    duration: 480
    tone: 64
    lyric: x
    pitch:
      data:
      - x: -1
        y: 0
        shape: io
      - x: 1
        y: 0
        shape: io
      snap_first: true
    vibrato: {length: 0, period: 175, depth: 25, in: 10, out: 10, shift: 0, drift: 0}
  - position: 1920
    duration: 960
    tone: 65
    lyric: la[l ae]
