# Mock project for tests — 4 notes, English CVVC (Teto mock bank)
# 120 BPM, 4/4, quarter note = 480 ticks = 500ms
ustx_version: 0.9
name: Mock Song
comment: ''
output_dir: ''
cache_dir: ''
bpm: 120
beat_per_bar: 4
beat_unit: 4
resolution: 1
expressions: {}
time_signatures:
- bar_position: 0
  beat_per_bar: 4
  beat_unit: 4
tempos:
- position: 0
  bpm: 120
tracks:
- track_name: Track1
  solo: false
  mute: false
  volume: 0
  pan: 0
  singer: ''
  phonemizer: ''
  voice_parts: []
  wave_parts: []
  track_expressions: []
  track_curves: []
