{
  "_comment": "Host-independent session conformance vectors (CONTRACT-v1 §6.17). Refs: @track:N @part:N @note:N @curve:N @last_note: @last_curve:. revision: current|stale|<n>. Vectors carrying a 'skip' reason are not run yet: they are reported as not-run, never as passing.",
  "vectors": [
    {
      "name": "note edit is one revision and one undo step",
      "project": "demo",
      "seed": 1,
      "steps": [
        {
          "op": "apply",
          "command": {
            "type": "note.set_lyric",
            "note_id": "@note:2",
            "lyric": "ka"
          },
          "expect": {
            "revision": 1,
            "changed": true,
            "changes": [
              "history.changed",
              "note.changed",
              "render.invalidated"
            ]
          }
        },
        {
          "op": "undo",
          "expect": {
            "revision": 2,
            "changed": true
          }
        },
        {
          "op": "redo",
          "expect": {
            "revision": 3,
            "changed": true
          }
        }
      ]
    },
    {
      "name": "unknown id is not_found and mutates nothing",
      "project": "demo",
      "seed": 1,
      "steps": [
        {
          "op": "apply",
          "command": {
            "type": "note.set_tone",
            "note_id": "ghost",
            "tone": 60
          },
          "expect": {
            "revision": 0,
            "code": "not_found"
          }
        },
        {
          "op": "undo",
          "expect": {
            "revision": 0,
            "changed": false
          }
        }
      ]
    },
    {
      "name": "stale expected_revision is a conflict",
      "project": "demo",
      "seed": 1,
      "steps": [
        {
          "op": "apply",
          "command": {
            "type": "note.set_tone",
            "note_id": "@note:0",
            "tone": 61
          },
          "expect": {
            "revision": 1
          }
        },
        {
          "op": "apply",
          "revision": 0,
          "command": {
            "type": "note.set_tone",
            "note_id": "@note:0",
            "tone": 62
          },
          "expect": {
            "revision": 1,
            "code": "revision_conflict"
          }
        }
      ]
    },
    {
      "name": "an added note is reported and then addressable",
      "project": "demo",
      "seed": 1,
      "steps": [
        {
          "op": "apply",
          "command": {
            "type": "note.add",
            "part_id": "@part:0",
            "tone": 72,
            "position_ticks": 2400,
            "duration_ticks": 480,
            "lyric": "new"
          },
          "expect": {
            "revision": 1,
            "changes": [
              "history.changed",
              "note.added",
              "render.invalidated"
            ]
          }
        },
        {
          "op": "apply",
          "command": {
            "type": "note.set_tone",
            "note_id": "@last_note:",
            "tone": 74
          },
          "expect": {
            "revision": 2,
            "changes": [
              "note.changed",
              "render.invalidated"
            ]
          }
        }
      ]
    },
    {
      "name": "moving a note keeps its id addressable",
      "project": "demo",
      "seed": 1,
      "steps": [
        {
          "op": "apply",
          "command": {
            "type": "note.move",
            "note_id": "@note:1",
            "delta_position_ticks": 4800,
            "delta_tone": 2
          },
          "expect": {
            "revision": 1
          }
        },
        {
          "op": "apply",
          "command": {
            "type": "note.set_lyric",
            "note_id": "@note:1",
            "lyric": "moved"
          },
          "expect": {
            "revision": 2,
            "changes": [
              "note.changed",
              "render.invalidated"
            ]
          }
        },
        {
          "op": "snapshot",
          "expect": {
            "revision": 2,
            "ids_stable": false
          }
        }
      ]
    },
    {
      "name": "curve stroke replaces an interval with canonical points",
      "project": "curve",
      "seed": 1,
      "steps": [
        {
          "op": "apply",
          "command": {
            "type": "curve.apply_stroke",
            "part_id": "@part:0",
            "curve_id": "@curve:0",
            "mode": "replace",
            "start_tick": 480,
            "end_tick": 960,
            "points": [
              {
                "tick": 612,
                "value": 20
              },
              {
                "tick": 700,
                "value": 5
              }
            ]
          },
          "expect": {
            "revision": 1,
            "changes": [
              "curve.changed",
              "history.changed",
              "render.invalidated"
            ],
            "point_count": 5
          }
        },
        {
          "op": "read_curve",
          "expect": {
            "revision": 1,
            "abbr": "dyn",
            "point_count": 5
          }
        },
        {
          "op": "undo",
          "expect": {
            "revision": 2
          }
        },
        {
          "op": "read_curve",
          "expect": {
            "revision": 2,
            "point_count": 2
          }
        }
      ]
    },
    {
      "name": "clearing the whole curve removes it",
