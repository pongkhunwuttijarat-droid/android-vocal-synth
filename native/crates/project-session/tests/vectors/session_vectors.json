          "expect": {
            "revision": 1,
            "changes": [
              "curve.changed",
              "history.changed",
              "render.invalidated"
            ]
          }
        },
        {
          "op": "read_curve",
          "expect": {
            "revision": 1,
            "code": "not_found"
          }
        }
      ]
    },
    {
