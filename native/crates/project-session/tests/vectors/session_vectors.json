    },
    {
      "name": "stroke rejections carry a reason and change nothing",
      "project": "curve",
      "seed": 1,
      "steps": [
        {
          "op": "apply",
          "command": {
            "type": "curve.apply_stroke",
            "part_id": "@part:0",
            "curve_id": "@curve:0",
            "mode": "replace",
            "start_tick": 480,
            "end_tick": 960,
            "points": [
              {
                "tick": 1200,
                "value": 1
              }
            ]
          },
          "expect": {
            "revision": 0,
            "code": "validation_error",
            "reason": "stroke_point_out_of_range"
          }
        },
        {
          "op": "apply",
          "command": {
            "type": "curve.apply_stroke",
            "part_id": "@part:0",
            "create": true,
            "abbr": "dyn",
            "mode": "replace",
            "start_tick": 0,
            "end_tick": 480,
            "points": [
              {
                "tick": 10,
                "value": 1
              }
            ]
          },
          "expect": {
            "revision": 0,
            "code": "validation_error",
            "reason": "duplicate_curve_descriptor"
          }
        }
      ]
    },
    {
      "name": "group commit is one revision and one undo step",
      "project": "demo",
      "seed": 1,
      "steps": [
        {
          "op": "group_begin",
          "name": "Drag notes",
          "expect": {
            "revision": 0
