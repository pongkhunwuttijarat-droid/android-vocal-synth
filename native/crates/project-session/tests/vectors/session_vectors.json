        },
        {
          "op": "group_child",
          "command": {
            "type": "note.set_tone",
            "note_id": "@note:1",
            "tone": 70
          },
          "expect": {
            "revision": 0,
            "changes": []
          }
        },
        {
          "op": "group_child",
          "command": {
            "type": "note.set_tone",
            "note_id": "@note:1",
            "tone": 71
          },
          "expect": {
            "revision": 0,
            "changes": []
          }
        },
        {
          "op": "group_commit",
          "expect": {
            "revision": 1,
            "changed": true,
            "changes": [
              "history.changed",
              "note.changed",
              "render.invalidated"
            ]
          }
        },
        {
          "op": "undo",
          "expect": {
            "revision": 2
          }
        }
      ]
    },
    {
