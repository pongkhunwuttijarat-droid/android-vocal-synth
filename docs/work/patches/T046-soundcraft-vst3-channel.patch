+#[test]
+fn synth_preserves_nonzero_midi_channels() {
+    let id = id_of("Fixture Synth");
+    let mut p = soundcraft_vst3_host::create(&id).unwrap();
+    p.prepare(48_000.0, 64, 2);
+    p.note_on_channel(12, 7, 60, 64).unwrap();
+    p.note_off_channel(48, 7, 60).unwrap();
+    let mut io = vec![vec![0.0f32; 64], vec![0.0f32; 64]];
+    p.process(&mut io, 64);
+    let expected = (64.0 / 127.0) * 8.0;
+    assert!(io[0][11].abs() < 1e-6);
+    assert!((io[0][12] - expected).abs() < 1e-6, "channel 7 was lost: {} != {expected}", io[0][12]);
+    assert!(io[0][12..48].iter().all(|&x| (x - expected).abs() < 1e-6));
+    assert!(io[0][48..].iter().all(|&x| x.abs() < 1e-6));
+    assert_eq!(io[0], io[1]);
+}
+
+#[test]
+fn mapped_controller_uses_its_midi_channel_and_rejects_silent_drops() {
+    use soundcraft_dsp::PluginEventError;
+
+    let id = id_of("Fixture Synth");
+    let mut p = soundcraft_vst3_host::create(&id).unwrap();
+    p.prepare(48_000.0, 64, 2);
+    p.midi_event(12, 7, [0xB7, 7, 96]).unwrap();
+    assert_eq!(p.midi_event(13, 7, [0xB7, 1, 127]), Err(PluginEventError::UnmappedMidiController), "unmapped CC must be explicit");
+    assert_eq!(p.midi_event(13, 7, [0xC7, 3, 0]), Err(PluginEventError::UnmappedMidiController), "unsupported program mapping must be explicit");
+    assert_eq!(p.midi_event(13, 6, [0xB7, 7, 96]), Err(PluginEventError::InvalidChannel), "message status and logical channel must agree");
+    assert_eq!(p.midi_event(usize::MAX, 7, [0xB7, 7, 96]), Err(PluginEventError::OffsetOutOfRange));
+    let mut io = vec![vec![0.0f32; 64], vec![0.0f32; 64]];
+    p.process(&mut io, 64);
+    assert!((io[0][11]).abs() < 1e-6);
+    assert!((io[0][12] - 96.0 / 127.0).abs() < 1e-6);
+
+    let mut full = soundcraft_vst3_host::create(&id).unwrap();
+    full.prepare(48_000.0, 64, 2);
+    for offset in 0..1024 {
+        full.midi_event(offset, 7, [0xB7, 7, 64]).unwrap();
+    }
+    assert_eq!(full.midi_event(1024, 7, [0xB7, 7, 64]), Err(PluginEventError::EventQueueFull));
+}
+
+#[test]
+fn note_event_rejections_are_typed_and_queue_is_bounded() {
+    use soundcraft_dsp::PluginEventError;
+
+    let synth_id = id_of("Fixture Synth");
+    let mut synth = soundcraft_vst3_host::create(&synth_id).unwrap();
+    synth.prepare(48_000.0, 64, 2);
+    assert_eq!(synth.note_on_channel(0, 16, 60, 100), Err(PluginEventError::InvalidChannel));
+    assert_eq!(synth.note_on_channel(0, 0, 128, 100), Err(PluginEventError::InvalidNote));
+    assert_eq!(synth.note_off_channel(usize::MAX, 0, 60), Err(PluginEventError::OffsetOutOfRange));
+    for offset in 0..1024 {
+        synth.note_on_channel(offset, 0, 60, 100).unwrap();
+    }
+    assert_eq!(synth.note_off_channel(1024, 0, 60), Err(PluginEventError::EventQueueFull));
+
+    let gain_id = id_of("Fixture Gain");
+    let mut gain = soundcraft_vst3_host::create(&gain_id).unwrap();
+    gain.prepare(48_000.0, 64, 2);
+    assert_eq!(gain.note_on_channel(0, 0, 60, 100), Err(PluginEventError::UnsupportedEventInput));
+}
